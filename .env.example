# ── Credentials GCP ───────────────────────────────────────────────────────────
# Chemin absolu vers votre fichier JSON de compte de service
GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/service-account.json

# ── Projet & région GCP ───────────────────────────────────────────────────────
GCP_PROJECT_ID=mon-projet-gcp
GCP_REGION=europe-west1

# ── Google Cloud Storage ──────────────────────────────────────────────────────
BUCKET_NAME=nom-du-bucket
FILE_PATH=data/entries.json

# ── OpenAI (fallback si Vertex AI indisponible) ───────────────────────────────
OPENAI_API_KEY=sk-...
